// pipeline parameters

params {
  // input data
  signatures_file = null // optional direct path to signatures file, if null, default signature tables will be used from params.signature_tables
  input_mutation_table = null // optional direct path to input mutation table file, if null, default input tables will be used from params.input_tables
  SP_extractor_output_path = null // optional path to SigProfilerExtractor output, if null, default input will be used
  SP_matrix_generator_output_path = null // optional path to SigProfilerMatrixGenerator output, if null, default input will be used
  COSMIC_signatures = false // if set to true, COSMIC signatures are used form SigProfiler output, otherwise de-novo ones are used
  dataset = 'SIM_test' // dataset name. Input matrices to be provided in params.input_tables/params.dataset, unless SigProfiler inputs are used
  mutation_types = ['SBS'] // add or remove mutation types if needed
  input_tables = "${projectDir}/input_mutation_tables" // default input tables path
  SBS_context = 96 // 96, 192, 288, 1536, 4608 context matrices can be provided (SBS only)
  number_of_samples = -1 // number of samples to analyse (-1 means all available)

  // output paths
  output_path = "${launchDir}" // output folder (absolute, or relative to the launch directory); default: the launch directory
  cleanup_temp = true // true: only results are published to output_path; false: intermediate files too (converted
                      // inputs and simulations in temp/, per-penalty optimisation folders, bootstrap iterations)

  // signatures to use
  signature_tables = "${projectDir}/signature_tables"
  signature_prefix = "sigProfiler" // prefix of signature files to use (e.g. sigProfiler, sigRandom)

  // simulations parameters
  run_only_simulations = false // set to true if only simulations are needed, these will be produced in output_tables folder
  number_of_simulated_samples = -1 // number of simulations to run (-1 means automatically apply a rounded factor of ten but not less than 1000)
  add_noise = true // add noise in simulations (recommended)
  noise_type = "gaussian" // set the type of noise in simulations: gaussian, poisson or negative_binomial (Gaussian by default)
  noise_stdev = 10 // set standard deviation of gaussian noise, in percentage of sample mutation burden (10 percent by default)
  zero_inflation_threshold = 0.05 // set the relative threshold below which all simulated signature activities are set to zero (0.05 by default)

  // optimisation flag and parameters
  run_only_optimisation = false // set to true if only optimisation is required, without final attributions
  optimised = true // if set to false, optimisation will run but not be used in final attributions
  optimisation_strategy = "removal" // optimisation strategy: removal (from all signatures, removes the weak ones),
                                    // addition (from SBS1 and SBS5, or the first signature of the table, adds
                                    // the strong ones) or add-remove (from the same start, alternates both)
  weak_thresholds = 'auto' // L2 similarity decrease thresholds to scan, excluding weakest signatures.
                           // 'auto' (default, removal strategy): 0 plus auto_weak_thresholds_number values
                           // chosen from the removal trajectories of the simulated data (log-spaced over
                           // the 5-95th percentiles of the points where the attributed signatures change,
                           // ignoring numerical noise below 1e-6); requires optimisation_strategy = "removal".
                           // Or an explicit list as before, e.g. [0, 0.0001, 0.0002, 0.0003]
                           // (command line: --weak_thresholds 0,0.0001,0.0002,0.0003)
  auto_weak_thresholds_number = 12 // number of non-zero thresholds chosen by weak_thresholds = 'auto'
  auto_weak_thresholds_samples = 300 // simulated samples whose trajectories choose the 'auto' thresholds (-1: all)
  threshold_scan = 'trajectory' // removal strategy: 'trajectory' (default) runs the greedy removal once per sample
                                // and replays it at every threshold (same results as one run per threshold);
                                // 'separate' runs it once per threshold, as before
  strong_thresholds = [0] // range of L2 similarity increase thresholds to be scanned, including strongest signatures:
                          // used by the addition and add-remove strategies (only one is needed for removal)
  bootstrap_method = "binomial" // bootstrap method: binomial, multinomial, multinomial_weight, poisson, classic
                              // (channels resampled with replacement) or bootstrap_residuals (residuals of the
                              // central fit resampled across channels and added to it)
  number_of_bootstrapped_samples_in_optimisation = 100 // at least 100 is recommended
  number_of_bootstrapped_samples = 1000 // bootstrap variations in final attribution, at least 1000 is recommended
  seed = null // RNG seed for the simulations and the bootstrap resampling. null: a seed is derived from the
              // Nextflow session ID (new for each fresh run, unchanged on -resume); either way the seed used is
              // logged and written to <output_path>/pipeline_info/run_info_<run name>.txt, and passing it back
              // with --seed reproduces the run (e.g. for a CPU-vs-GPU comparison)
  bootstrap_chunk_size = 0 // bootstrap iterations per scheduler job. 0 (default): one iteration per job on CPU,
                           // all iterations in one job on GPU. Set a positive value to batch iterations on CPU
                           // (each job pays ~2 s of Python start-up) or to spread a GPU run over several GPUs
                           // (e.g. 250 splits 1000 iterations into 4 GPU jobs). Results do not depend on it
  use_GPU = false // false (default): run the NNLS on CPU, one bootstrap iteration per scheduler job unless
                  // bootstrap_chunk_size is set; true: offload the batched NNLS to cuML on the GPU, running all
                  // bootstrap iterations of an attribution in one job unless bootstrap_chunk_size is set
  gpu_precision = 'mixed' // GPU floating-point precision: 'mixed' (fp32 solve, fp64 score), 'fp32', or 'fp64'
  gpu_batch_size = 0 // NNLS problems per batched GPU call; 0 = auto-size to the GPU's memory
                     // (bigger batch for smaller contexts / larger cards). Set a positive value to override
  gpu_conda_env = null // FULL PATH to the conda env with the source-built cuML (e.g.
                       // '/home/you/miniforge3/envs/all_cuda-133_arch-x86_64'), for the GPU NNLS
                       // processes. Must be a path, not a bare name: Nextflow's conda directive
                       // treats a bare name as a package to install. Applied only when use_GPU=true,
                       // to processes labelled 'gpu_nnls' (see below)
  confidence_level = 0.95 // specify the confidence level for CI calculation (default: 0.95)
  metric_to_prioritise = "specificity" // set a metric to prioritise (default: specificity), requiring at least the specified threshold or closest alternative
  metric_threshold = 0.95 // specify the minimum threshold of the prioritised metric
  signatures_to_prioritise = [] // set a list of signatures to prioritise (empty list means all, by default)
  signatures_to_deprioritise = [] // set a list of signatures to deprioritise (empty list means none, by default)
  no_CI_for_penalties = false // do not use confidence intervals for optimal penalties calculation
  calculate_penalty_on_average = false // apply criteria based on signatures overall (on average, less conservative), rather than maximising prioritised metric for every signature (more conservative)

  // plotting flags
  plot_optimisation_plots = true
  plot_bootstrap_attributions = true
  plot_metrics = true
  plot_signatures = true
  plot_input_spectra = true
  plot_fitted_spectra = false
  plot_residuals = false
  show_poisson_errors = false
  show_strands = false // only works with higher contexts (192, 288)
  show_nontranscribed_region = false // only wortks with higher contexts (288)

  // simulated data (datasets with a truth table): attribution thresholds (in %) of the confidence probability curves and sensitivity thresholds
  signature_attribution_thresholds = 0..20

  // software environments (see README: "Reproducibility")
  conda_env = "${projectDir}/conda-lock/environment." + (System.getProperty('os.name').toLowerCase().contains('mac')
      ? (System.getProperty('os.arch') in ['aarch64', 'arm64'] ? 'osx-arm64' : 'osx-64')
      : (System.getProperty('os.arch') in ['aarch64', 'arm64'] ? 'linux-aarch64' : 'linux-64')) + '.txt'
      // conda env of the CPU processes under -profile conda: the exact lock of environment.yml for this
      // platform (regenerate with conda-lock/update_locks.sh). Set to "${projectDir}/environment.yml"
      // for an unpinned solve, e.g. on a platform without a lock file
  container_image = 'ssenkin/msa@sha256:0647240af3ecacf6356502d91f676403941700694ecd8c7c03c843d9a3e4f471'
      // image for -profile docker/singularity/apptainer: ssenkin/msa:v4.0, a multi-architecture
      // index (linux/amd64 and linux/arm64; each engine pulls the image of its own platform),
      // pinned by digest so a moved tag cannot change what runs. Digest only, without the tag:
      // Apptainer rejects a reference with both a tag and a digest. Update the digest when
      // publishing a new image: docker buildx imagetools inspect ssenkin/msa:<tag>

  help = false
}

manifest {
    homePage = 'https://gitlab.com/s.senkin/MSA'
    description = 'Mutational signature attribution with confidence intervals based on simulations'
    mainScript = 'run_auto_optimised_analysis.nf'
    nextflowVersion = '>=25.04.0' // tested with 26.04.6 (pin it with NXF_VER=26.04.6) and 25.04.8
}

profiles {
  conda {
    conda.enabled = true
    process.conda = params.conda_env
  }
  docker {
    docker.enabled = true
    docker.runOptions = "-u \$(id -u):\$(id -g) -v ${launchDir}:${launchDir} -e MPLCONFIGDIR=.matplotlib -e XDG_CACHE_HOME=.cache"
    process.container = params.container_image
  }
  apptainer {
    apptainer.enabled = true
    apptainer.autoMounts = true
    apptainer.runOptions = "-B ${launchDir},${projectDir}"
    apptainer.envWhitelist="SINGULARITYENV_APPEND_PATH"
    // the digest-pinned Docker Hub image, converted by Nextflow (same bits as -profile docker);
    // the Sylabs library copy is 'library://ssenkin/default/msa:v3.1' (not digest-pinned)
    process.container = params.container_image
  }
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    singularity.runOptions = "-B ${launchDir},${projectDir}"
    singularity.envWhitelist="APPTAINERENV_APPEND_PATH"
    // the digest-pinned Docker Hub image, converted by Nextflow (same bits as -profile docker);
    // the Sylabs library copy is 'library://ssenkin/default/msa:v3.1' (not digest-pinned)
    process.container = params.container_image
  }
  test {
    params {
      dataset = 'SIM_test'
      mutation_types = ['SBS', 'DBS', 'ID']
      number_of_bootstrapped_samples_in_optimisation = 10
      number_of_bootstrapped_samples = 10
      number_of_simulated_samples = 10
      weak_thresholds = 'auto'
      auto_weak_thresholds_number = 3
      strong_thresholds = [0]
      signature_prefix = 'sigTest'
      bootstrap_chunk_size = 5 // two jobs per bootstrap: exercises chunking at a fraction of the job count
    }
    // the test data are tiny: keep every request within a laptop or a CI runner
    process.resourceLimits = [cpus: 2, memory: 2.GB]
  }
  test_GPU {
    params {
      dataset = 'SIM_test_GPU'
      mutation_types = ['SBS']
      // sized for a quick check of the GPU path: 1000 simulated samples, 20 + 100 bootstrap
      // iterations. A full-size run of this dataset (11,000 simulated samples, 100 + 1000
      // iterations, e.g. to compare CPU and GPU) took 2.5 h on GPUs: pass
      // --number_of_simulated_samples -1 --number_of_bootstrapped_samples_in_optimisation 100
      // --number_of_bootstrapped_samples 1000 --auto_weak_thresholds_samples 300
      number_of_simulated_samples = 1000
      number_of_bootstrapped_samples_in_optimisation = 20
      number_of_bootstrapped_samples = 100
      auto_weak_thresholds_samples = 100
      weak_thresholds = 'auto'
      strong_thresholds = [0]
      signature_prefix = 'sigProfiler'
      // the GPU test: still needs gpu_conda_env (or a GPU container) and a GPU queue (-c gpu.config).
      // For a CPU comparison, pass --use_GPU false --bootstrap_chunk_size 0: on CPU, the iterations
      // of a task run one after the other
      use_GPU = true
      bootstrap_chunk_size = 50 // the final bootstrap as 2 GPU jobs, which tests the split
      // the test is about the NNLS: skip the per-sample plots of the 1001 samples (about 1 h of
      // input spectra and 3 h of bootstrap plots on one CPU)
      plot_input_spectra = false
      plot_bootstrap_attributions = false
    }
  }
}

process {
    // -e: a failing command fails the task (instead of only the last command counting);
    // -u: unset variables are errors. Nextflow's default is -ue; pipefail is added on top.
    shell =  ['/bin/bash', '-euo', 'pipefail']

    // Resources, sized on a typical run (one mutation type, 1000 samples, 65 SBS signatures,
    // default settings; README "Running on a cluster"). Every task is single-threaded, so it
    // requests one CPU; the pipeline runs wide instead (about 1,100 tasks for such a run).
    // A task killed for exceeding its memory (exit status 130-145, e.g. 137) is retried with
    // twice, then three times the memory. Override per process in your own config, e.g.
    // withLabel: 'memory_high' { memory = 32.GB }, and cap every request at your largest job
    // with process.resourceLimits = [cpus: 8, memory: 64.GB, time: 24.h].
    cpus = 1
    memory = { 2.GB * task.attempt }
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries = 2
    withLabel: 'memory_medium' {
        memory = { 4.GB * task.attempt }
    }
    withLabel: 'memory_high' {
        memory = { 8.GB * task.attempt }
    }
}

// Task environment variables: matplotlib config and font caches in each task's work directory
// (relative paths), so tasks write nothing outside it. Uses the top-level 'env' scope; the old
// 'process.environment' map is not a recognised option.
env {
    MPLCONFIGDIR = '.matplotlib'
    XDG_CACHE_HOME = '.cache'
    // One maths thread per task, matching the one CPU each task requests (process.cpus is left at
    // its default of 1). Otherwise NumPy/SciPy's OpenBLAS starts a thread per core of the node,
    // which oversubscribes shared cluster nodes (250-1300% CPU per task on 96-core nodes) without
    // speeding up the small NNLS problems. Raise them together with process.cpus, if ever.
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
}

// GPU / cuML: the NNLS processes that can offload to the GPU are labelled 'gpu_nnls'
// (see modules/nnls.nf). Everything GPU- or cluster-specific is kept OUT of this file
// so nothing here needs editing per site. Two independent, process-scoped hooks:
//
//   1. conda env (below): when use_GPU=true and params.gpu_conda_env is set (in the
//      config of the GPU runs, e.g. gpu.config, or via --gpu_conda_env), the labelled
//      processes run in that env - the one holding
//      the source-built cuML - while everything else keeps the default env. Falls back
//      to the default env otherwise, and is inert unless conda is enabled (-profile
//      conda), so CPU / docker / bare runs are unaffected.
//
//   2. queue / GPU request / resources: the 'gpu_nnls' label is the single place to
//      attach any GPU-related per-process directive (queue, clusterOptions/--gres,
//      accelerator, or a prebuilt-image container instead of conda). Keep these in a
//      separate, uncommitted config passed only for GPU runs (e.g. `-c gpu.config`),
//      so nothing cluster-specific is committed and CPU runs never see them. That
//      file needs no conditional - it is only loaded for GPU runs. Config files use
//      the `=` directive form (not the `directive value` body form):
//
//        // gpu.config
//        process {
//            withLabel: 'gpu_nnls' {
//                queue = 'gpu'
//                clusterOptions = '--gres=gpu:1'          // SLURM: how the GPU is requested
//                // accelerator = 1                       // executor-agnostic (k8s/cloud) alternative
//                // container = 'ssenkin/msa-gpu:latest'  // use a prebuilt cuML image instead of conda
//            }
//        }
//        // RMM pool cap in MiB, divided across processes sharing the GPU (unset -> 60% of
//        // total memory, fine for one GPU job per device). Set it in the env scope: an
//        // `env` setting inside withLabel is not a directive (warned about and ignored).
//        // env {
//        //     RMM_POOL_SIZE_MIB = '40000'
//        // }
process {
    withLabel: 'gpu_nnls' {
        // A closure, evaluated for each task: a plain value would be evaluated when this file is
        // read, before the params of a -c config file (e.g. gpu.config) are set, and the GPU tasks
        // would silently run in the default env. (use_GPU is a string when given on the command
        // line with the strict parser)
        conda = { (params.use_GPU.toBoolean() && params.gpu_conda_env) ? "${params.gpu_conda_env}" : params.conda_env }
        // GPU jobs load the CUDA libraries and run all bootstrap iterations in one job
        memory = { (params.use_GPU.toBoolean() ? 8.GB : 2.GB) * task.attempt }
    }
}

// Nextflow's reports, in <output_path>/pipeline_info/ next to run_info_<run name>.txt. These paths are
// set when this file is read: an output_path given on the command line or in a params file
// (-params-file) is seen, one set in a -c config file is not (the reports then go to the launch directory)
timeline {
  enabled = true
  overwrite = true
  file = "${params.output_path}/pipeline_info/MSA-nf_timeline.html"
}

report {
  enabled = true
  overwrite = true
  file = "${params.output_path}/pipeline_info/MSA-nf_report.html"
}

trace {
  enabled = true
  overwrite = true
  file = "${params.output_path}/pipeline_info/MSA-nf_trace.txt"
}

dag {
  enabled = true
  overwrite = true
  file = "${params.output_path}/pipeline_info/MSA-nf_dag.html"
}
