// pipeline parameters

params {
  // input data
  signatures_file = null // optional direct path to signatures file, if null, default signature tables will be used from params.signature_tables
  input_mutation_table = null // optional direct path to input mutation table file, if null, default input tables will be used from params.input_tables
  SP_extractor_output_path = null // optional path to SigProfilerExtractor output, if null, default input will be used
  SP_matrix_generator_output_path = null // optional path to SigProfilerMatrixGenerator output, if null, default input will be used
  COSMIC_signatures = false // if set to true, COSMIC signatures are used form SigProfiler output, otherwise de-novo ones are used
  dataset = 'SIM_test' // dataset name. Input matrices to be provided in params.input_tables/params.dataset, unless SigProfiler inputs are used
  mutation_types = ['SBS'] // add or remove mutation types if needed
  input_tables = "${projectDir}/input_mutation_tables" // default input tables path
  SBS_context = 96 // 96, 192, 288, 1536, 4608 context matrices can be provided (SBS only)
  number_of_samples = -1 // number of samples to analyse (-1 means all available)

  // output paths
  output_path = "${launchDir}" // specify full path to output folder, default is current working directory
  cleanup_temp = true // set to true to remove temporary files after run is complete

  // signatures to use
  signature_tables = "${projectDir}/signature_tables"
  signature_prefix = "sigProfiler" // prefix of signature files to use (e.g. sigProfiler, sigRandom)

  // simulations parameters
  run_only_simulations = false // set to true if only simulations are needed, these will be produced in output_tables folder
  number_of_simulated_samples = -1 // number of simulations to run (-1 means automatically apply a rounded factor of ten but not less than 1000)
  add_noise = true // add noise in simulations (recommended)
  noise_type = "gaussian" // set the type of noise in simulations: gaussian, poisson or negative_binomial (Gaussian by default)
  noise_stdev = 10 // set standard deviation of gaussian noise, in percentage of sample mutation burden (10 percent by default)
  zero_inflation_threshold = 0.05 // set the relative threshold below which all simulated signature activities are set to zero (0.05 by default)

  // optimisation flag and parameters
  run_only_optimisation = false // set to true if only optimisation is required, without final attributions
  optimised = true // if set to false, optimisation will run but not be used in final attributions
  optimisation_strategy = "removal" // optimisation strategy (removal, addition or add-remove)
  weak_thresholds = [0, 0.0001, 0.0002, 0.0003] // range of L2 similarity decrease thresholds to be scanned, excluding weakest signatures - adjust if needed
  strong_thresholds = [0] // range of L2 similarity increase thresholds to be scanned, including strongest signatures: only one is sufficient in default removal strategy
  bootstrap_method = "binomial" // bootstrap flag and method (binomial, multinomial, residuals, classic, bootstrap_residuals)
  number_of_bootstrapped_samples_in_optimisation = 100 // at least 100 is recommended
  number_of_bootstrapped_samples = 1000 // bootstrap variations in final attribution, at least 1000 is recommended
  use_GPU = false // false (default): run one bootstrap iteration per scheduler job for maximum CPU parallel width;
                  // true: run all bootstrap iterations for a given attribution within a single job (one reused
                  // GPU context per job, fewer jobs) - intended for GPU/cuML acceleration
  confidence_level = 0.95 // specify the confidence level for CI calculation (default: 0.95)
  metric_to_prioritise = "specificity" // set a metric to prioritise (default: specificity), requiring at least the specified threshold or closest alternative
  metric_threshold = 0.95 // specify the minimum threshold of the prioritised metric
  signatures_to_prioritise = [] // set a list of signatures to prioritise (empty list means all, by default)
  signatures_to_deprioritise = [] // set a list of signatures to deprioritise (empty list means none, by default)
  no_CI_for_penalties = false // do not use confidence intervals for optimal penalties calculation
  calculate_penalty_on_average = false // apply criteria based on signatures overall (on average, less conservative), rather than maximising prioritised metric for every signature (more conservative)

  // plotting flags
  plot_optimisation_plots = true
  plot_bootstrap_attributions = true
  plot_metrics = true
  plot_signatures = true
  plot_input_spectra = true
  plot_fitted_spectra = false
  plot_residuals = false
  show_poisson_errors = false
  show_strands = false // only works with higher contexts (192, 288)
  show_nontranscribed_region = false // only wortks with higher contexts (288)

  // if SIM in dataset name (synthetic data), use the following percentage range for measuring signature attirbution sensitivities
  signature_attribution_thresholds = 0..20

  help = null
}

// detect system architecture to select appropriate docker image

def arch = System.properties['os.arch']
def imageTag = (arch == 'aarch64' || arch == 'arm64') ? 'arm64' : 'amd64'

manifest {
    homePage = 'https://gitlab.com/s.senkin/MSA'
    description = 'Mutational signature attribution with confidence intervals based on simulations'
    mainScript = 'run_auto_optimised_analysis.nf'
}

profiles {
  conda {
    conda.enabled = true
    process.conda = "${projectDir}/environment.yml"
  }
  docker {
    docker.enabled = true
    docker.runOptions = "-u \$(id -u):\$(id -g) -v ${launchDir}:${launchDir} -v ${params.output_path}:${params.output_path} -e MPLCONFIGDIR=${params.output_path}/temp/matplotlib -e XDG_CACHE_HOME=${params.output_path}/temp"
    process.container = "ssenkin/msa:${imageTag}"
  }
  apptainer {
    apptainer.enabled = true
    apptainer.autoMounts = true
    apptainer.runOptions = "-B ${launchDir},${projectDir}"
    apptainer.envWhitelist="SINGULARITYENV_APPEND_PATH"
    process.container = 'library://ssenkin/default/msa:v3.1'
  }
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    singularity.runOptions = "-B ${launchDir},${projectDir}"
    singularity.envWhitelist="APPTAINERENV_APPEND_PATH"
    process.container = 'library://ssenkin/default/msa:v3.1'
  }
  test {
    params {
      dataset = 'SIM_test'
      mutation_types = ['SBS', 'DBS', 'ID']
      number_of_bootstrapped_samples_in_optimisation = 10
      number_of_bootstrapped_samples = 10
      number_of_simulated_samples = 10
      weak_thresholds = [0, 0.01, 0.02]
      strong_thresholds = [0]
      signature_prefix = 'sigTest'
    }
  }
}

process {
    shell =  ['/bin/bash','-o','pipefail']
}

process {
    beforeScript = "mkdir -p ${params.output_path}/temp/matplotlib ${params.output_path}/temp/fontconfig"
    environment = [
        'MPLCONFIGDIR': "${params.output_path}/temp/matplotlib",
        'XDG_CACHE_HOME': "${params.output_path}/temp"
    ]
}

timeline {
  enabled = true
  overwrite = true
  file = "${launchDir}/nf-pipeline_info/MSA-nf_timeline.html"
}

report {
  enabled = true
  overwrite = true
  file = "${launchDir}/nf-pipeline_info/MSA-nf_report.html"
}

trace {
  enabled = true
  overwrite = true
  file = "${launchDir}/nf-pipeline_info/MSA-nf_trace.txt"
}

dag {
  enabled = true
  overwrite = true
  file = "${launchDir}/nf-pipeline_info/MSA-nf_dag.html"
}
